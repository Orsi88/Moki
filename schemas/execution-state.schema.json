{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quality-agents/execution-state",
  "title": "Moki run state",
  "type": "object",
  "required": ["schemaVersion", "id", "project", "createdAt", "updatedAt", "status", "currentStep", "completedSteps", "pending", "approvals", "inputs", "results", "artifacts"],
  "properties": {
    "schemaVersion": { "type": "string", "enum": ["1"] },
    "id": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{4}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "project": { "type": "string", "minLength": 1 },
    "skill": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "workflow": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "activity": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$", "description": "The Moki activity the run was started from (activities/ or the workspace library). Absent when the request did not come from one." },
    "tool": { "type": "string", "description": "AI tool that last updated the run (informational only)." },
    "terminal": { "type": "string", "pattern": "^t[\\w-]{1,40}$", "description": "The Moki desktop terminal the run was created in (recorded by npm run new-run from QA_TERMINAL); the app opens the run's deliverables in that terminal's group." },
    "createdAt": { "type": "string", "minLength": 10 },
    "updatedAt": { "type": "string", "minLength": 10 },
    "status": { "type": "string", "enum": ["in-progress", "awaiting-approval", "awaiting-input", "blocked", "paused", "completed", "cancelled"] },
    "currentStep": { "type": "string" },
    "completedSteps": { "type": "array", "items": { "type": "string" } },
    "pending": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "owner": { "type": "string" },
          "resolution": { "type": "string" }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step", "decision", "at"],
        "properties": {
          "step": { "type": "string" },
          "decision": { "type": "string", "enum": ["approved", "rejected", "adjusted"] },
          "by": { "type": "string" },
          "at": { "type": "string" },
          "notes": { "type": "string" }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "contextSources": {
      "type": "array",
      "description": "Files of other projects read as shared context, through project tags, with the user's authorization in the request.",
      "items": {
        "type": "object",
        "required": ["path", "project"],
        "properties": {
          "path": { "type": "string", "pattern": "^workspace/projects/[a-z0-9-]+/" },
          "project": { "type": "string" },
          "tag": { "type": "string" }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Tracker items the run used (dispatch skill): the version adopted as the basis of the work and the last update check.",
      "items": {
        "type": "object",
        "required": ["tracker", "item", "checkedAt", "origin"],
        "properties": {
          "tracker": { "type": "string", "enum": ["azure-devops", "jira"] },
          "item": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "revision": { "type": "string", "description": "Azure DevOps rev, or Jira updated timestamp." },
          "snapshot": { "type": "string", "description": "The snapshot file in the run's inputs folder." },
          "checkedAt": { "type": "string", "minLength": 10 },
          "origin": { "type": "string", "enum": ["tracker", "user"], "description": "Read through the MCP, or sent by the user." },
          "adopted": { "type": "boolean", "description": "Whether this version is the basis of the work (a found change is not adopted until decided)." },
          "lastCheck": {
            "type": "object",
            "required": ["at", "result"],
            "properties": {
              "at": { "type": "string", "minLength": 10 },
              "result": { "type": "string", "enum": ["unchanged", "changed", "failed"] },
              "revisionSeen": { "type": "string" },
              "note": { "type": "string" }
            }
          }
        }
      }
    },
    "results": { "type": "array", "items": { "type": "object" } },
    "artifacts": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(workspace/projects/[a-z0-9-]+/|<target-repo>/)" }
    }
  }
}
